    "provider.auth_bearer_nonstandard_hint" : {
      "comment" : "Warning hint when Bearer is selected with Anthropic protocol",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearer خيار غير قياسي لـ Anthropic. استخدمه لخدمات الوكيل (مثل AITunnel مع مسار Claude الاصلي)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearer ist eine nicht-standardmaessige Wahl fuer Anthropic. Verwenden fuer Proxy-Dienste (z.B. AITunnel mit nativem Claude-Route)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearer is a non-standard choice for Anthropic. Use for proxy services (e.g. AITunnel with native Claude route)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearer es una eleccion no estandar para Anthropic. Usar para servicios proxy (p. ej. AITunnel con ruta Claude nativa)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearer est un choix non standard pour Anthropic. A utiliser pour les services proxy (ex. AITunnel avec route Claude native)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearer Anthropic के लिए गैर-मानक विकल्प है। प्रॉक्सी सेवाओं के लिए उपयोग करें (जैसे AITunnel नेटिव Claude रूट के साथ)।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BearerはAnthropicには非標準の選択です。プロキシサービス（例：AITunnelのネイティブClaudeルート）に使用してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearer e uma escolha nao padrao para Anthropic. Use para servicos de proxy (ex. AITunnel com rota Claude nativa)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearer — нестандартный выбор для Anthropic. Используйте для прокси-сервисов (например, AITunnel с нативным маршрутом Claude)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearer 对于 Anthropic 是非标准选项。用于代理服务（如带有原生 Claude 路由的 AITunnel）。"
          }
        }
      }
    },
