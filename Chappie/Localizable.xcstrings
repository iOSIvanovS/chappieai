        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライセンスが期限切れか未アクティベートです。Chappie の使用を続けるにはライセンスをアクティベートしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua licença expirou ou não está ativada. Por favor, ative uma licença para continuar usando o Chappie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша лицензия истекла или не активирована. Пожалуйста, активируйте лицензию, чтобы продолжить использование Chappie."
