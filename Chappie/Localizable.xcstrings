    "eula.section5_body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالنقر على قبول، تؤكد أنك قرأت هذه الاتفاقية وفهمت محتواها وتقبل المسؤولية عن استخدام ChappieAI."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Tippen auf Akzeptieren bestätigen Sie, dass Sie diese Vereinbarung gelesen haben, deren Inhalt verstehen und die Verantwortung für die Nutzung von ChappieAI übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By tapping Accept, you confirm that you have read this agreement, understand its content, and accept responsibility for using ChappieAI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tocar Aceptar, confirmas que has leído este acuerdo, entiendes su contenido y aceptas la responsabilidad por el uso de ChappieAI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En appuyant sur Accepter, vous confirmez avoir lu cet accord, en comprendre le contenu et accepter la responsabilité d'utiliser ChappieAI."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वीकार करें पर टैप करके, आप पुष्टि करते हैं कि आपने इस समझौते को पढ़ा है, इसकी सामग्री को समझते हैं, और ChappieAI के उपयोग की जिम्मेदारी स्वीकार करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「同意する」をタップすることで、この契約を読み、その内容を理解し、ChappieAIの使用に対する責任を受け入れることを確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao tocar em Aceitar, você confirma que leu este acordo, entende seu conteúdo e aceita a responsabilidade pelo uso do ChappieAI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажимая «Принять», вы подтверждаете, что прочитали это соглашение, понимаете его содержание и принимаете ответственность за использование ChappieAI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击接受，即表示您确认已阅读本协议，理解其内容，并接受使用 ChappieAI 的责任。"
          }
        }
      }
    },
