    "content.no_model_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حذف النموذج المحدد. افتح الإعدادات وقم بتوصيل مزود أو اختر نموذجاً مختلفاً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Modell wurde gelöscht. Öffnen Sie die Einstellungen und verbinden Sie einen Anbieter oder wählen Sie ein anderes Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected model was deleted. Open settings and connect a provider or select a different model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo seleccionado fue eliminado. Abre la configuración y conecta un proveedor o selecciona un modelo diferente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle sélectionné a été supprimé. Ouvrez les paramètres et connectez un fournisseur ou sélectionnez un modèle différent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुना गया मॉडल हटा दिया गया। सेटिंग खोलें और एक प्रदाता कनेक्ट करें या कोई अलग मॉडल चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したモデルが削除されました。設定を開いてプロバイダーを接続するか、別のモデルを選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo selecionado foi excluído. Abra as configurações e conecte um provedor ou selecione um modelo diferente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранная модель была удалена. Откройте настройки и подключите провайдера или выберите другую модель."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选模型已被删除。请打开设置并连接提供商或选择其他模型。"
          }
        }
      }
    },
