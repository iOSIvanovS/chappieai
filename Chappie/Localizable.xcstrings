    "providers.delete_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف المزود وجميع مفاتيحه. ستظهر تحذيرات في الخيوط التي تستخدم هذا المزود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anbieter und alle seine Schlüssel werden gelöscht. Threads, die diesen Anbieter verwenden, zeigen eine Warnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The provider and all its keys will be deleted. Threads using this provider will show a warning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor y todas sus claves serán eliminados. Los hilos que usan este proveedor mostrarán una advertencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur et toutes ses clés seront supprimés. Les fils utilisant ce fournisseur afficheront un avertissement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदाता और उसकी सभी कुंजियाँ हटा दी जाएंगी। इस प्रदाता का उपयोग करने वाले थ्रेड चेतावनी दिखाएंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダーとそのすべてのキーが削除されます。このプロバイダーを使用するスレッドには警告が表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor e todas as suas chaves serão excluídos. Os tópicos que usam este provedor mostrarão um aviso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер и все его ключи будут удалены. Треды, использующие этого провайдера, покажут предупреждение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供商及其所有密钥将被删除。使用此提供商的线程将显示警告。"
          }
        }
      }
    },
