    "license.paywall_subtitle" : {
      "comment" : "Paywall screen subtitle",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية ترخيصك أو لم يتم تفعيله. يرجى تفعيل ترخيص لمواصلة استخدام Chappie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
