        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directorio de proveedores: claves y modelos para cada uno. La selección de proveedor y modelo ocurre en el chip de modelo en la barra de herramientas del chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répertoire des fournisseurs : clés et modèles pour chacun. La sélection du fournisseur et du modèle se fait dans la puce Modèle dans la barre d'outils du chat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदाता निर्देशिका: प्रत्येक के लिए कुंजियाँ और मॉडल। प्रदाता और मॉडल चयन चैट टूलबार में मॉडल चिप में होता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダーディレクトリ：各プロバイダーのキーとモデル。プロバイダーとモデルの選択はチャットツールバーのモデルチップで行います。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diretório de provedores: chaves e modelos para cada um. A seleção de provedor e modelo acontece no chip de modelo na barra de ferramentas do chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Справочник провайдеров: ключи и модели для каждого. Выбор провайдера и модели происходит в чипе модели в тулбаре чата."
          }
