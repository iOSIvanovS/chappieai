    "provider.auth_xapikey_nonstandard_hint" : {
      "comment" : "Warning hint when x-api-key is selected with OpenAI protocol",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x-api-key خيار غير قياسي لبروتوكول OpenAI. استخدمه فقط اذا كان المزود يتطلب هذا الرأس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x-api-key ist eine nicht-standardmaessige Wahl fuer das OpenAI-kompatible Protokoll. Nur verwenden, wenn der Anbieter diesen Header benoetigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x-api-key is a non-standard choice for OpenAI-compatible protocol. Use only if the provider requires this header."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x-api-key es una eleccion no estandar para el protocolo compatible con OpenAI. Usar solo si el proveedor requiere este encabezado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x-api-key est un choix non standard pour le protocole compatible OpenAI. A utiliser uniquement si le fournisseur requiert cet en-tete."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x-api-key OpenAI-संगत प्रोटोकॉल के लिए गैर-मानक विकल्प है। केवल तभी उपयोग करें जब प्रदाता इस हेडर की मांग करे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x-api-keyはOpenAI互換プロトコルには非標準の選択です。プロバイダーがこのヘッダーを必要とする場合のみ使用してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "x-api-key e uma escolha nao padrao para o protocolo compativel com OpenAI. Use apenas se o provedor exigir este cabecalho."
          }
        },
        "ru" : {
