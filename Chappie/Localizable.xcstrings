    "settings.onboarding_hint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد تشغيل معالج الإعداد الأولي. لن يتم حذف البيانات الموجودة — يتم فقط إضافة المزودين والمفاتيح والنماذج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führen Sie den ersten Einrichtungsassistenten erneut aus. Vorhandene Daten werden nicht gelöscht — Anbieter, Schlüssel und Modelle werden nur ergänzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-run the initial setup wizard. Existing data is not deleted — providers, keys, and models are only supplemented."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ejecutar el asistente de configuración inicial. Los datos existentes no se eliminan — los proveedores, claves y modelos solo se complementan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relancez l'assistant de configuration initial. Les données existantes ne sont pas supprimées — les fournisseurs, clés et modèles sont seulement complétés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रारंभिक सेटअप विज़ार्ड फिर से चलाएं। मौजूदा डेटा हटाया नहीं जाता — प्रदाता, कुंजियाँ और मॉडल केवल पूरक होते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期セットアップウィザードを再実行します。既存のデータは削除されません — プロバイダー、キー、モデルは補完されるだけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute novamente o assistente de configuração inicial. Os dados existentes não são excluídos — provedores, chaves e modelos são apenas complementados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно запустите мастер начальной настройки. Существующие данные не удаляются — провайдеры, ключи и модели только дополняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新运行初始设置向导。现有数据不会被删除 — 提供商、密钥和模型只会被补充。"
          }
        }
      }
    },
