    "project.settings.advisor_limits" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في دور المستشار، تتوفر فقط read_file وlist_files. جميع أدوات الكتابة وgit والاختبار والطرفية محظورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Beraterrolle sind nur read_file und list_files verfügbar. Alle Schreib-, Git-, Test- und Terminal-Tools sind gesperrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In advisor role only read_file and list_files are available. All write, git, test, and terminal tools are blocked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rol asesor solo están disponibles read_file y list_files. Todas las herramientas de escritura, git, pruebas y terminal están bloqueadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rôle conseiller, seuls read_file et list_files sont disponibles. Tous les outils d'écriture, git, tests et terminal sont bloqués."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सलाहकार भूमिका में केवल read_file और list_files उपलब्ध हैं। सभी लेखन, git, परीक्षण और टर्मिनल टूल अवरुद्ध हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドバイザーロールでは read_file と list_files のみ使用可能です。すべての書き込み、git、テスト、ターミナルツールはブロックされています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No papel de consultor, apenas read_file e list_files estão disponíveis. Todas as ferramentas de escrita, git, testes e terminal estão bloqueadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В роли советника доступны только read_file и list_files. Все инструменты записи, git, тесты и терминал заблокированы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顾问角色仅可使用 read_file 和 list_files。所有写入、git、测试和终端工具均被屏蔽。"
          }
        }
      }
    },
