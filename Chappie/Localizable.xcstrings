    "terminal.access.auto.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينفذ الوكيل الأوامر دون تأكيد. استخدم فقط إذا كنت تثق تماماً بالوكيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent führt Befehle ohne Bestätigung aus. Nur verwenden, wenn Sie dem Agenten vollständig vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent executes commands without confirmation. Use only if you fully trust the agent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente ejecuta comandos sin confirmación. Úsalo solo si confías completamente en el agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agent exécute des commandes sans confirmation. À utiliser uniquement si vous faites entièrement confiance à l'agent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एजेंट बिना पुष्टि के कमांड निष्पादित करता है। केवल तभी उपयोग करें जब आप एजेंट पर पूरी तरह भरोसा करते हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントは確認なしにコマンドを実行します。エージェントを完全に信頼する場合のみ使用してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agente executa comandos sem confirmação. Use apenas se confiar completamente no agente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент выполняет команды без подтверждения. Используйте только если полностью доверяете агенту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理无需确认即执行命令。仅在完全信任代理时使用。"
          }
        }
      }
    },
