    "eula.section3_body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتحمل مطور ChappieAI أي مسؤولية عن الأضرار المباشرة أو غير المباشرة الناجمة عن استخدام هذه الأداة، بما في ذلك على سبيل المثال لا الحصر: فقدان البيانات، والضرر بالمشاريع، والخسائر المالية، أو أي عواقب أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Entwickler von ChappieAI haftet nicht für direkte oder indirekte Schäden, die durch die Nutzung dieses Tools entstehen, einschließlich, aber nicht beschränkt auf: Datenverlust, Projektschäden, finanzielle Verluste oder andere Folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The developer of ChappieAI is not liable for any direct or indirect damages arising from the use of this tool, including but not limited to: data loss, project damage, financial losses, or other consequences."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desarrollador de ChappieAI no es responsable de ningún daño directo o indirecto derivado del uso de esta herramienta, incluyendo, entre otros: pérdida de datos, daños al proyecto, pérdidas financieras u otras consecuencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le développeur de ChappieAI n'est pas responsable des dommages directs ou indirects résultant de l'utilisation de cet outil, y compris, mais sans s'y limiter : perte de données, dommages au projet, pertes financières ou autres conséquences."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI का डेवलपर इस टूल के उपयोग से उत्पन्न किसी भी प्रत्यक्ष या अप्रत्यक्ष नुकसान के लिए उत्तरदायी नहीं है, जिसमें शामिल हैं लेकिन सीमित नहीं: डेटा हानि, प्रोजेक्ट क्षति, वित्तीय हानि, या अन्य परिणाम।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAIの開発者は、データの損失、プロジェクトへの損害、経済的損失、その他の結果を含むがこれらに限定されない、このツールの使用から生じる直接的または間接的な損害について一切責任を負いません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desenvolvedor do ChappieAI não é responsável por quaisquer danos diretos ou indiretos decorrentes do uso desta ferramenta, incluindo, mas não se limitando a: perda de dados, danos ao projeto, perdas financeiras ou outras consequências."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разработчик ChappieAI не несёт ответственности за прямой или косвенный ущерб, возникший в результате использования этого инструмента, включая, но не ограничиваясь: потерей данных, повреждением проекта, финансовыми потерями или иными последствиями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI 的开发者对因使用本工具而产生的任何直接或间接损害不承担责任，包括但不限于：数据丢失、项目损坏、财务损失或其他后果。"
          }
        }
      }
    },
