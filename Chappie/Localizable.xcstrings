    "memory.delete_warning" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف %1$lld رسالة قديمة من المحادثة %2$@ نهائيا. لا يمكن التراجع عن هذا الاجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld alteste Nachrichten aus dem Thread %2$@ werden geloscht. Dies kann nicht ruckgangig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld oldest messages from thread \"%2$@\" will be deleted. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld mensajes mas antiguos del hilo %2$@ seran eliminados. Esta accion no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
