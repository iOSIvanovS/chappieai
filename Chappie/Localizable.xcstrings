          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu licencia ha expirado o no está activada. Por favor, activa una licencia para continuar usando Chappie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre licence a expiré ou n'est pas activée. Veuillez activer une licence pour continuer à utiliser Chappie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका लाइसेंस समाप्त हो गया है या सक्रिय नहीं है। Chappie का उपयोग जारी रखने के लिए कृपया लाइसेंस सक्रिय करें।"
