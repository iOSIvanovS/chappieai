    "project.settings.terminal_auto_warning" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سينفذ الوكيل الأوامر دون تأكيد. تأكد من أنك تثق بالنموذج والمزود الحاليين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent führt Befehle ohne Bestätigung aus. Stellen Sie sicher, dass Sie dem aktuellen Modell und Anbieter vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent will execute commands without confirmation. Make sure you trust the current model and provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente ejecutará comandos sin confirmación. Asegúrate de confiar en el modelo y proveedor actuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agent exécutera des commandes sans confirmation. Assurez-vous de faire confiance au modèle et au fournisseur actuels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एजेंट बिना पुष्टि के कमांड निष्पादित करेगा। सुनिश्चित करें कि आप वर्तमान मॉडल और प्रदाता पर भरोसा करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントは確認なしにコマンドを実行します。現在のモデルとプロバイダーを信頼していることを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agente executará comandos sem confirmação. Certifique-se de confiar no modelo e provedor atuais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент будет выполнять команды без подтверждения. Убедитесь, что доверяете текущей модели и провайдеру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
