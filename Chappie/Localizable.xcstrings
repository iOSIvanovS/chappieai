    "settings.onboarding_confirm_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيفتح معالج الإعداد مجدداً. سيتم الحفاظ على بياناتك وخيوطك ومزوديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Einrichtungsassistent wird erneut geöffnet. Ihre Daten, Threads und Anbieter bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The setup wizard will open again. Your data, threads, and providers will be preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente de configuración se abrirá de nuevo. Tus datos, hilos y proveedores se conservarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'assistant de configuration s'ouvrira à nouveau. Vos données, fils et fournisseurs seront préservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटअप विज़ार्ड फिर से खुलेगा। आपका डेटा, थ्रेड और प्रदाता सुरक्षित रहेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セットアップウィザードが再度開きます。データ、スレッド、プロバイダーは保持されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O assistente de configuração será aberto novamente. Seus dados, tópicos e provedores serão preservados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мастер настройки откроется снова. Ваши данные, треды и провайдеры сохранятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置向导将再次打开。您的数据、线程和提供商将被保留。"
          }
        }
      }
    },
