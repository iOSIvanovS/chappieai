    "settings.keychain_hint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain هو مخزن مشفر لنظام macOS محمي بكلمة مرورك. المفاتيح غير متاحة للتطبيقات الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain ist ein verschlüsselter macOS-Speicher, der durch Ihr Passwort geschützt ist. Schlüssel sind für andere Apps nicht zugänglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain is an encrypted macOS storage protected by your password. Keys are inaccessible to other apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain es un almacén cifrado de macOS protegido por tu contraseña. Las claves no son accesibles para otras aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain est un stockage chiffré macOS protégé par votre mot de passe. Les clés ne sont pas accessibles aux autres applications."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain macOS का एक एन्क्रिप्टेड स्टोरेज है जो आपके पासवर्ड से सुरक्षित है। कुंजियाँ अन्य ऐप्स के लिए उपलब्ध नहीं हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychainはパスワードで保護されたmacOSの暗号化ストレージです。キーは他のアプリからアクセスできません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain é um armazenamento criptografado do macOS protegido pela sua senha. As chaves não são acessíveis a outros aplicativos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain — зашифрованное хранилище macOS, защищённое вашим паролем. Ключи недоступны другим приложениям."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain 是受您密码保护的 macOS 加密存储。密钥对其他应用程序不可访问。"
          }
        }
      }
    },
