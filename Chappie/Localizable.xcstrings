    "system.memory_cleared" : {
      "comment" : "System message shown in chat after clearing history",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم مسح الذاكرة. لقد نسيت كل ما ناقشناه. مستعد للبداية من جديد!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicher geloescht. Ich habe alles vergessen, was wir besprochen haben. Bereit, neu anzufangen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memory cleared. I've forgotten everything we discussed. Ready to start fresh!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria borrada. He olvidado todo lo que hablamos. Listo para empezar de nuevo!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoire effacee. J'ai oublie tout ce que nous avons discute. Pret a repartir!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेमोरी साफ हो गई। मैं हमारी सभी बातें भूल गया। नए सिरे से शुरू करने के लिए तैयार!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリをクリアしました。これまでの会話をすべて忘れました。新たにスタートする準備ができています！"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria apagada. Esqueci tudo o que discutimos. Pronto para comecar do zero!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Память очищена. Я забыл всё, о чём мы говорили. Готов начать с чистого листа!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记忆已清除。我已忘记我们讨论的一切。准备好重新开始！"
          }
        }
      }
    },
