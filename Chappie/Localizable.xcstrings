    "thread.settings.unlimited_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إرسال جميع رسائل المحادثة في الطلب. قد يزيد التكلفة بشكل كبير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Thread-Nachrichten werden in der Anfrage gesendet. Kann die Kosten erheblich erhöhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All thread messages are sent in the request. May significantly increase cost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los mensajes del hilo se envían en la solicitud. Puede aumentar considerablemente el costo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les messages du fil sont envoyés dans la requête. Peut augmenter considérablement le coût."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी थ्रेड संदेश अनुरोध में भेजे जाते हैं। लागत काफी बढ़ सकती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スレッドのすべてのメッセージがリクエストに含まれます。コストが大幅に増加する可能性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as mensagens da conversa são enviadas na solicitação. Pode aumentar significativamente o custo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все сообщения треда передаются в запросе. Может сильно увеличить стоимость."
          }
        },
