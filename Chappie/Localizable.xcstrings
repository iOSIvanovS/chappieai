    "memory.delete_confirm_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف %1$lld رسالة قديمة من المحادثة %2$@ نهائيا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld alteste Nachrichten aus dem Thread %2$@ werden dauerhaft geloscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld oldest messages from thread \"%2$@\" will be permanently deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld mensajes mas antiguos del hilo %2$@ seran eliminados permanentemente."
