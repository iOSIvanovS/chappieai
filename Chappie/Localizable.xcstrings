          "stringUnit" : {
            "state" : "translated",
            "value" : "संदेश इतिहास पूरी तरह संग्रहीत है। यहाँ आप प्रत्येक थ्रेड का आकार देख सकते हैं और पुराने संदेश हटा सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージ履歴は完全に保存されます。ここで各スレッドのサイズを確認し、古いメッセージを削除できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico de mensagens é armazenado completo. Aqui você pode ver o tamanho de cada tópico e excluir mensagens antigas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История сообщений хранится полностью. Здесь можно просмотреть размер каждого треда и удалить старые сообщения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息历史完整存储。在这里您可以查看每个线程的大小并删除旧消息。"
          }
        }
      }
    },
