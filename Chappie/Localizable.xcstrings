    "project.settings.downgrade_alert_message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير الدور إلى المستشار سيعيد تعيين جميع حقوق الوصول (git، الاختبارات، الهندسة المعمارية، التعليقات، الطرفية). هل تريد المتابعة؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ändern der Rolle zu Berater setzt alle Zugriffsrechte zurück (Git, Tests, Architektur, Kommentare, Terminal). Fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing role to Advisor will reset all access rights (git, tests, architecture, comments, terminal). Continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el rol a Asesor restablecerá todos los derechos de acceso (git, pruebas, arquitectura, comentarios, terminal). ¿Continuar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer le rôle en Conseiller réinitialisera tous les droits d'accès (git, tests, architecture, commentaires, terminal). Continuer ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भूमिका को सलाहकार में बदलने से सभी एक्सेस अधिकार रीसेट हो जाएंगे (git, टेस्ट, आर्किटेक्चर, टिप्पणियाँ, टर्मिनल)। जारी रखें?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "役割をアドバイザーに変更すると、すべてのアクセス権（git、テスト、アーキテクチャ、コメント、ターミナル）がリセットされます。続けますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o papel para Consultor redefinirá todos os direitos de acesso (git, testes, arquitetura, comentários, terminal). Continuar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смена роли на Советник сбросит все права доступа (git, тесты, архитектура, комментарии, терминал). Продолжить?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将角色更改为顾问将重置所有访问权限（git、测试、架构、注释、终端）。是否继续？"
          }
        }
      }
    },
