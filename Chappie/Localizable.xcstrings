    "eula.section1_body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI هو أداة برمجية مصممة للمساعدة في التطوير والتحليل وأتمتة المهام. Chappie ليس وكيلاً مستقلاً ولا يتخذ قرارات نيابةً عن المستخدم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI ist ein Software-Tool zur Unterstützung bei Entwicklung, Analyse und Aufgabenautomatisierung. Chappie ist kein autonomer Agent und trifft keine Entscheidungen für den Benutzer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI is a software tool designed to assist with development, analysis, and task automation. Chappie is not an autonomous agent and does not make decisions for the user."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI es una herramienta de software diseñada para ayudar con el desarrollo, análisis y automatización de tareas. Chappie no es un agente autónomo y no toma decisiones por el usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI est un outil logiciel conçu pour aider au développement, à l'analyse et à l'automatisation des tâches. Chappie n'est pas un agent autonome et ne prend pas de décisions pour l'utilisateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI एक सॉफ़्टवेयर टूल है जो विकास, विश्लेषण और कार्य स्वचालन में सहायता के लिए डिज़ाइन किया गया है। Chappie एक स्वायत्त एजेंट नहीं है और उपयोगकर्ता के लिए निर्णय नहीं लेता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAIは、開発、分析、タスク自動化を支援するために設計されたソフトウェアツールです。Chappieは自律エージェントではなく、ユーザーに代わって決定を下しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI é uma ferramenta de software projetada para auxiliar no desenvolvimento, análise e automação de tarefas. Chappie não é um agente autônomo e não toma decisões pelo usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI — программный инструмент для помощи в разработке, анализе и автоматизации задач. Chappie не является автономным агентом и не принимает решения за пользователя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChappieAI 是一款旨在协助开发、分析和任务自动化的软件工具。Chappie 不是自主代理，不会为用户做决定。"
          }
        }
      }
    },
    "eula.section1_title" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chappie — أداة مطور"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chappie — ein Entwicklerwerkzeug"
          }
        },
        "en" : {
          "stringUnit" : {
