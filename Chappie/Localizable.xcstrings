    "settings.providers_hint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دليل المزودين: المفاتيح والنماذج لكل مزود. يتم اختيار المزود والنموذج في شريحة النموذج في شريط أدوات الدردشة."
          }
        },
        "de" : {
          "stringUnit" : {
