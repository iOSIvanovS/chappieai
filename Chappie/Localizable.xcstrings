        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un proveedor del catálogo o configura una conexión manualmente.\nAgrega una clave y selecciona los modelos que necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un fournisseur dans le catalogue ou configurez une connexion manuellement.\nAjoutez une clé et sélectionnez les modèles dont vous avez besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैटलॉग से एक प्रदाता चुनें या मैन्युअल रूप से कनेक्शन कॉन्फ़िगर करें।\nएक कुंजी जोड़ें और आवश्यक मॉडल चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カタログからプロバイダーを選択するか、手動で接続を設定してください。\nキーを追加して必要なモデルを選択します。"
