    "onboarding.provider_subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مزوداً من الكتالوج أو قم بتكوين اتصال يدوياً.\nأضف مفتاحاً وحدد النماذج التي تحتاجها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen Anbieter aus dem Katalog oder konfigurieren Sie eine Verbindung manuell.\nFügen Sie einen Schlüssel hinzu und wählen Sie die benötigten Modelle aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a provider from the catalog or configure a connection manually.\nAdd a key and select the models you need."
