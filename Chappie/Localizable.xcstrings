          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थ्रेड %2$@ के %1$lld सबसे पुराने संदेश हटा दिए जाएंगे। यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スレッド %2$@ の最も古い %1$lld 件のメッセージが削除されます。この操作は取り消せません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld mensagens mais antigas do topico %2$@ serao excluidas. Esta acao nao pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld старейших сообщений из треда %2$@ будут удалены. Это действие нельзя отменить."
