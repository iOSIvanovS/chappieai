    "project.settings.starter_executor_alert_message" : {
      "comment" : "Alert message explaining Executor mode is not available on Starter plan",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع المنفذ متاح في خطتَي Pro وTeam. قم بترقية خطتك لفتح وصول الوكيل الكامل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ausführungsmodus ist in den Plänen Pro und Team verfügbar. Upgraden Sie Ihren Plan, um vollen Agentenzugriff freizuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executor mode is available on Pro and Team plans. Upgrade your plan to unlock full agent access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo ejecutor está disponible en los planes Pro y Team. Actualiza tu plan para desbloquear el acceso completo al agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode exécuteur est disponible avec les plans Pro et Team. Mettez à niveau votre plan pour débloquer l'accès complet à l'agent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक्जीक्यूटर मोड Pro और Team प्लान में उपलब्ध है। पूर्ण एजेंट एक्सेस अनलॉक करने के लिए अपना प्लान अपग्रेड करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エグゼキューターモードはProおよびTeamプランで利用できます。フルエージェントアクセスを解除するにはプランをアップグレードしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo executor está disponível nos planos Pro e Team. Faça upgrade do seu plano para desbloquear o acesso completo ao agente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим исполнителя доступен в планах «Про» и «Тим». Обновите план, чтобы разблокировать полный доступ агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "执行者模式适用于 Pro 和 Team 计划。升级您的计划以解锁完整的代理访问权限。"
          }
        }
      }
    },
